# Do NOT exclude LICENSE or .github — scripts/copydir.go uses them as repo-root anchors
# during `go generate`, which runs inside `make build` in the Dockerfile.
.git
.gitignore
build/
.picoclaw/
config/
.env
.env.example
*.md
assets/

# host-built deps (Windows binaries) must never enter the build context
web/frontend/node_modules
web/frontend/dist
web/preview-dist
